# Anthropic API key for Claude-powered devotional generation
ANTHROPIC_API_KEY=sk-ant-...

# Cloudflare Turnstile keys (get from https://dash.cloudflare.com/?to=/:account/turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...

# Database path (default: ./data/devotionals.db)
# In Docker, this should point to the mounted volume
DB_PATH=/app/data/devotionals.db
